PORT=8000
HOST=127.0.0.1
DATABASE_URL=postgresql://usuario:password@localhost:5432/crm_db

# Clave con la que se firman los tokens de sesión.
# Debe ser distinta en cada entorno y nunca subirse al repositorio.
# Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=reemplazar-por-una-clave-aleatoria-de-al-menos-32-bytes

# Duración de la sesión en minutos (480 = 8 horas)
TOKEN_EXPIRA_MINUTOS=480

# ── Proveedor de IA (opcional) ──
# Si se deja vacío, el sistema funciona igual pero no genera resúmenes.
#
# La integración usa el formato de chat completions compatible con OpenAI, así que
# sirve tanto un servicio alojado como un modelo corriendo en la propia máquina.
#
# Servicio alojado:
#   IA_BASE_URL=https://api.del-proveedor.com/v1
#   IA_API_KEY=la-clave-del-proveedor
#   IA_MODELO=nombre-del-modelo
#
# Modelo local con Ollama (no necesita clave):
#   IA_BASE_URL=http://localhost:11434/v1
#   IA_API_KEY=local
#   IA_MODELO=llama3
IA_BASE_URL=
IA_API_KEY=
IA_MODELO=
IA_TIMEOUT_SEGUNDOS=60

# Tope de tokens de la respuesta. Acota el costo máximo por resumen.
# Ojo: los modelos de razonamiento gastan tokens internos que cuentan contra este
# tope y no se devuelven. Con un valor bajo el resumen puede llegar vacío.
IA_MAX_TOKENS=1200

# Temperatura del modelo. Dejar vacío para no enviarla.
# Los modelos GPT-5 y GPT-6 de OpenAI solo aceptan su valor por defecto y rechazan
# la petición si se incluye este parámetro. Un modelo local sí suele aceptarla.
IA_TEMPERATURA=
